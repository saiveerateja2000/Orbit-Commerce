# ============================================================
#  OrbitCommerce – Example Environment Variables
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
#  PostgreSQL
# ────────────────────────────────────────────────────────────
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change_me_strong_password

# Per-service DATABASE_URL pattern (constructed automatically in docker-compose.yml):
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<db_name>
#
# Individual DB names (created by services/init-db.sql):
#   user_db | product_db | order_db | payment_db | notification_db

# ────────────────────────────────────────────────────────────
#  Shared Secrets
# ────────────────────────────────────────────────────────────

# HS256/HS512 secret used for JWT signing across all services
SECRET_KEY=replace_with_a_long_random_secret_at_least_64_chars

# Admin-only API key for internal service-to-service calls
ADMIN_KEY=replace_with_a_secure_admin_api_key

# ────────────────────────────────────────────────────────────
#  JWT Settings (User Service)
# ────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ────────────────────────────────────────────────────────────
#  Payment Service (Stripe)
# ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# ────────────────────────────────────────────────────────────
#  Notification Service (SMTP)
# ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@orbitcommerce.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=noreply@orbitcommerce.com

# ────────────────────────────────────────────────────────────
#  OpenTelemetry / Jaeger
# ────────────────────────────────────────────────────────────
OTLP_ENDPOINT=http://jaeger:4317

# ────────────────────────────────────────────────────────────
#  Frontend
# ────────────────────────────────────────────────────────────
REACT_APP_API_BASE_URL=http://localhost/api
REACT_APP_ENV=production

# ────────────────────────────────────────────────────────────
#  Grafana
# ────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password

# ────────────────────────────────────────────────────────────
#  Logging
# ────────────────────────────────────────────────────────────
LOG_LEVEL=info
